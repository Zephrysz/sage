# Google AI
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

PGHOST=db.project.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=password

# Indexer
TRANSCRIPTS_PATH=/data/transcripts.zip

# Server
PORT=8000

# Frontend public API URL (baked into Next.js at build time)
# In prod, set this to your public backend URL, e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS allowed origins (comma-separated)
# In prod, set to your frontend domain, e.g. https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3333

# Session store path (use a Docker volume path in prod)
SESSION_STORE_PATH=/data/sessions.json

# TTS (Google Cloud API key with Cloud Text-to-Speech API enabled)
# Get it from: https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_KEY=your_google_cloud_api_key_here
