# Google AI
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

PGHOST=db.project.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=password

# Indexer
TRANSCRIPTS_PATH=/data/transcripts.zip

# Server
PORT=8000

# TTS (Google Cloud API key with Cloud Text-to-Speech API enabled)
# Get it from: https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_KEY=your_google_cloud_api_key_here
